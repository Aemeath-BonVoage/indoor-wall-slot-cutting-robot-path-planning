<?xml version="1.0" encoding="utf-8"?>
<!-- Modified for ROS2 compatibility -->
<robot name="scr_robot">
  
  <!-- 材质定义 -->
  <material name="silver">
    <color rgba="0.808 0.843 0.906 1"/>
  </material>
  
  <material name="black">
    <color rgba="0.2 0.2 0.2 1"/>
  </material>
  
  <material name="blue">
    <color rgba="0.2 0.4 0.8 1"/>
  </material>
  
  <material name="red">
    <color rgba="0.8 0.2 0.2 1"/>
  </material>

  <!-- 底盘基座 -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.0271869545617233 -1.19461122941034E-05 0.240742282977963" rpy="0 0 0" />
      <mass value="6.49820335119445" />
      <inertia
        ixx="0.212134328832715"
        ixy="-4.36268536173614E-08"
        ixz="-0.000322313919588723"
        iyy="0.190547802895951"
        iyz="-5.62513007166979E-06"
        izz="0.0905915740494004" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://scr_description/meshes/base_link.STL" />
      </geometry>
      <material name="silver" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://scr_description/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- 左前轮 (Left Front) -->
  <link name="lf_link">
