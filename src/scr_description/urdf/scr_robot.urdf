  <joint name="joint_lf_link" type="continuous">
    <origin xyz="0.29625 0.212 -0.052484" rpy="1.5708 0 0" />
    <parent link="base_link" />
    <child link="lf_link" />
    <axis xyz="0 0 1" />
  </joint>

  <!-- 右前轮 (Right Front) -->
  <link name="rf_link">
    <inertial>
      <origin xyz="-8.43667760097588E-08 -4.99532847100803E-08 0.0305109948019305" rpy="0 0 0" />
